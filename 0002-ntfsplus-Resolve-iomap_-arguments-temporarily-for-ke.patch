From: shadichy <shadichy@blisslabs.org>
Date: Thu, 6 Nov 2025 16:39:19 +0700
Subject: [PATCH 2/7] ntfsplus: Resolve iomap_* arguments for kernel 6.17+

Add compatibility for:
- iomap_writepages API change in 6.17
- iomap_read_folio/iomap_readahead API change in 6.19

Signed-off-by: shadichy <shadichy@blisslabs.org>
---
 fs/ntfsplus/aops.c  | 11 +++++++++--
 fs/ntfsplus/file.c  | 14 +++++++-------
 fs/ntfsplus/inode.c |  2 +-
 fs/ntfsplus/inode.h | 32 ++++++++++++++++++++++++++++++++
 4 files changed, 49 insertions(+), 10 deletions(-)

diff --git a/fs/ntfsplus/aops.c b/fs/ntfsplus/aops.c
index 9a1b3b80a..xxxxxxxxx 100644
--- a/fs/ntfsplus/aops.c
+++ b/fs/ntfsplus/aops.c
@@ -114,7 +114,7 @@ static int ntfs_read_folio(struct file *file, struct folio *folio)
 			return ntfs_read_compressed_block(folio);
 	}
 
-	return iomap_read_folio(folio, &ntfs_read_iomap_ops);
+	return __iomap_read_folio(folio, &ntfs_read_iomap_ops);
 }
 
 static int ntfs_write_mft_block(struct ntfs_inode *ni, struct folio *folio,
@@ -416,7 +416,7 @@ static void ntfs_readahead(struct readahead_control *rac)
 	    (ni->mft_no == FILE_MFT || ni->mft_no == FILE_MFTMirr))
 		return;
 
-	iomap_readahead(rac, &ntfs_read_iomap_ops);
+	__iomap_readahead(rac, &ntfs_read_iomap_ops);
 }
 
 static int ntfs_mft_writepage(struct folio *folio, struct writeback_control *wbc)
@@ -447,9 +447,13 @@ static int ntfs_writepages(struct address_space *mapping,
 {
 	struct inode *inode = mapping->host;
 	struct ntfs_inode *ni = NTFS_I(inode);
+
+	// Use the new iomap interface from 6.17
 	struct iomap_writepage_ctx wpc = {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 17, 0))
 		.inode		= mapping->host,
 		.wbc		= wbc,
+#endif
 		.ops		= &ntfs_writeback_ops,
 	};
 
@@ -474,7 +478,12 @@ static int ntfs_writepages(struct address_space *mapping,
 		return -EACCES;
 	}
 
+	// Use the new iomap writepages from 6.17
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 17, 0))
 	return iomap_writepages(&wpc);
+#else
+	return iomap_writepages(mapping, wbc, &wpc, &ntfs_writeback_ops);
+#endif
 }
 
 static int ntfs_swap_activate(struct swap_info_struct *sis,
diff --git a/fs/ntfsplus/file.c b/fs/ntfsplus/file.c
index aebc2b48b..ab7bb4ff7 100644
--- a/fs/ntfsplus/file.c
+++ b/fs/ntfsplus/file.c
@@ -290,7 +290,7 @@ int ntfsp_setattr(struct mnt_idmap *idmap, struct dentry *dentry,
 			/* Serialize against page faults */
 			if (NInoNonResident(NTFS_I(vi)) &&
 			    attr->ia_size < old_size) {
-				err = iomap_truncate_page(vi, attr->ia_size, NULL,
+				err = __iomap_truncate_page(vi, attr->ia_size, NULL,
 							  &ntfs_read_iomap_ops,
 							  &ntfs_iomap_folio_ops, NULL);
 				if (err)
@@ -309,7 +309,7 @@ int ntfsp_setattr(struct mnt_idmap *idmap, struct dentry *dentry,
 				loff_t len = min_t(loff_t,
 							round_up(old_size, PAGE_SIZE) - old_size,
 							attr->ia_size - old_size);
-				err = iomap_zero_range(vi, old_size, len,
+				err = __iomap_zero_range(vi, old_size, len,
 						       NULL, &ntfs_read_iomap_ops,
 						       &ntfs_iomap_folio_ops, NULL);
 			}
@@ -627,7 +627,7 @@ static ssize_t ntfs_file_write_iter(struct kiocb *iocb, struct iov_iter *from)
 
 			offset = iocb->ki_pos;
 			iocb->ki_flags &= ~IOCB_DIRECT;
-			written = iomap_file_buffered_write(iocb, from,
+			written = __iomap_file_buffered_write(iocb, from,
 					&ntfs_write_iomap_ops, &ntfs_iomap_folio_ops,
 					NULL);
 			if (written < 0) {
@@ -647,7 +647,7 @@ static ssize_t ntfs_file_write_iter(struct kiocb *iocb, struct iov_iter *from)
 							 end >> PAGE_SHIFT);
 		}
 	} else {
-		ret = iomap_file_buffered_write(iocb, from, &ntfs_write_iomap_ops,
+		ret = __iomap_file_buffered_write(iocb, from, &ntfs_write_iomap_ops,
 				&ntfs_iomap_folio_ops, NULL);
 	}
 out:
@@ -1021,7 +1021,7 @@ static long ntfs_fallocate(struct file *file, int mode, loff_t offset, loff_t le
 
 			to = min_t(loff_t, (start_vcn + 1) << vol->cluster_size_bits,
 				   end_offset);
-			err = iomap_zero_range(vi, offset, to - offset, NULL,
+			err = __iomap_zero_range(vi, offset, to - offset, NULL,
 					       &ntfs_read_iomap_ops,
 					       &ntfs_iomap_folio_ops, NULL);
 			if (err < 0 || (end_vcn - start_vcn) == 1)
@@ -1032,7 +1032,7 @@ static long ntfs_fallocate(struct file *file, int mode, loff_t offset, loff_t le
 			loff_t from;
 
 			from = (end_vcn - 1) << vol->cluster_size_bits;
-			err = iomap_zero_range(vi, from, end_offset - from, NULL,
+			err = __iomap_zero_range(vi, from, end_offset - from, NULL,
 					       &ntfs_read_iomap_ops,
 					       &ntfs_iomap_folio_ops, NULL);
 			if (err < 0 || (end_vcn - start_vcn) == 1)
@@ -1084,7 +1084,7 @@ static long ntfs_fallocate(struct file *file, int mode, loff_t offset, loff_t le
 			loff_t len = min_t(loff_t,
 					   round_up(old_size, PAGE_SIZE) - old_size,
 					   offset - old_size);
-			err = iomap_zero_range(vi, old_size, len, NULL,
+			err = __iomap_zero_range(vi, old_size, len, NULL,
 					       &ntfs_read_iomap_ops,
 					       &ntfs_iomap_folio_ops, NULL);
 		}
diff --git a/fs/ntfsplus/inode.c b/fs/ntfsplus/inode.c
index fb5f40e19..7ed279c7b 100644
--- a/fs/ntfsplus/inode.c
+++ b/fs/ntfsplus/inode.c
@@ -2434,7 +2434,7 @@ int ntfs_extend_initialized_size(struct inode *vi, const loff_t offset,
 		return err;
 
 	if (!NInoCompressed(ni) && old_init_size < offset) {
-		err = iomap_zero_range(vi, old_init_size,
+		err = __iomap_zero_range(vi, old_init_size,
 				       offset - old_init_size,
 				       NULL, &ntfs_read_iomap_ops,
 				       &ntfs_iomap_folio_ops, NULL);
diff --git a/fs/ntfsplus/inode.h b/fs/ntfsplus/inode.h
index 95fee0fd2..yyyyyyyyy 100644
--- a/fs/ntfsplus/inode.h
+++ b/fs/ntfsplus/inode.h
@@ -350,4 +350,36 @@ int ntfs_extend_initialized_size(struct inode *vi, const loff_t offset,
 		const loff_t new_size);
 void ntfs_set_vfs_operations(struct inode *inode, mode_t mode, dev_t dev);
 
+/* iomap API compatibility for Linux 6.17+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 17, 0)
+#define __iomap_file_buffered_write iomap_file_buffered_write
+#define __iomap_truncate_page iomap_truncate_page
+#define __iomap_zero_range iomap_zero_range
+#else
+#define __iomap_file_buffered_write(iocb, from, ops, __write_ops, private) \
+	iomap_file_buffered_write(iocb, from, ops, private)
+#define __iomap_truncate_page(inode, pos, did_zero, ops, __write_ops, private) \
+	iomap_truncate_page(inode, pos, did_zero, ops, private)
+#define __iomap_zero_range(inode, pos, len, did_zero, ops, __write_ops, private) \
+	iomap_zero_range(inode, pos, len, did_zero, ops, private)
+#endif
+
+/* iomap_read_folio and iomap_readahead compatibility for Linux 6.19+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 19, 0)
+static inline int __iomap_read_folio(struct folio *folio, const struct iomap_ops *ops)
+{
+	struct iomap_read_folio_ctx ctx = { .folio = folio };
+	iomap_read_folio(ops, &ctx);
+	return 0;
+}
+
+static inline void __iomap_readahead(struct readahead_control *rac, const struct iomap_ops *ops)
+{
+	struct iomap_read_folio_ctx ctx = { .rac = rac };
+	iomap_readahead(ops, &ctx);
+}
+#else
+#define __iomap_read_folio iomap_read_folio
+#define __iomap_readahead iomap_readahead
+#endif
 #endif /* _LINUX_NTFS_INODE_H */
-- 
2.52.0